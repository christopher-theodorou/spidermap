# Copy to /etc/spidermap-standalone/spidermap.env (outside the SpiderMap folder, so it never reaches git or the image)
# How browsers reach SpiderMap: scheme, host and port, exactly. Changes from any other origin are refused.
SPIDERMAP_PUBLIC_ORIGIN=https://spidermap.example.net
# The absolute address of your Zabbix frontend's zabbix.php (for the "open in Zabbix" links)
SPIDERMAP_ZABBIX_FRONTEND=https://zabbix.example.net/zabbix.php
