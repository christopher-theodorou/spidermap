# Copy to zabbix.env (install.sh does this for you). Never commit zabbix.env.
export ZABBIX_URL="http://127.0.0.1/zabbix/api_jsonrpc.php"
export ZABBIX_TOKEN="paste-your-zabbix-api-token-here"

# Optional: read-only Proxmox token -> names and state of every VM / container
# export PVE_URL="https://192.168.1.10:8006"
# export PVE_TOKEN_ID="spidermap@pve!spidermap"
# export PVE_TOKEN_SECRET="paste-the-token-secret-here"
